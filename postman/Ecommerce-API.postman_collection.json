    {
      "name": "Addresses",
      "description": "Logged-in user only. A regular user token is enough. First address becomes default. Maximum 10 addresses per user.",
      "item": [
        {
          "name": "Get Addresses",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
