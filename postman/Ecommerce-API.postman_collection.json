              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "addresses", "{{addressId}}"]
            },
            "description": "Returns one address owned by the current user.\n\n- Invalid ID: `400`.\n- Address not in this user's list: `404`."
          },
          "response": []
        },
        {
          "name": "Update Address",
          "event": [
            {
              "listen": "test",
