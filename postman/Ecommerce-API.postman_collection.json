              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Electronics {{$timestamp}}\",\n  \"description\": \"Electronic devices and accessories\",\n  \"image\": \"https://example.com/categories/electronics.jpg\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories"]
            },
            "description": "Admin only. Creates a category and saves `id` to `categoryId`.\n\n### Fields\n- `name`: required, 3–50 characters, trimmed.\n- `description`: optional, max 500 characters.\n- `image`: optional, image URL as a string.\n- `slug`: do not send; generated by the server from `name`.\n\nUsing `{{$timestamp}}` avoids duplicate names when re-running the request.\n\n- No token: `401`.\n- Logged-in `user`: `403`."
          },
          "response": []
        },
        {
          "name": "Get All Categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number, starting from 1. Default: 1."
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page, from 1 to 100. Default: 10."
                }
              ]
            },
            "description": "Public. Lists categories with `pagination` so guests can browse without logging in.\n\n### `pagination` fields\n- `total`: total number of categories.\n- `totalPages`: total number of pages.\n- `page`: current page.\n- `limit`: page size."
          },
          "response": []
        },
        {
          "name": "Get Category By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories", "{{categoryId}}"]
            },
            "description": "Public. Returns a single category by `categoryId`.\n\n- Invalid ID: `400`.\n- Valid ID not found: `404`."
          },
          "response": []
        },
        {
          "name": "Update Category",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Electronics {{$timestamp}}\",\n  \"description\": \"Updated category description\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories", "{{categoryId}}"]
            },
            "description": "Admin only. Updates only the fields sent in the body.\n\n### Allowed fields\n- `name`\n- `description`\n- `image`\n\nAt least one field is required. Changing `name` updates `slug` automatically."
          },
          "response": []
        },
        {
          "name": "Delete Category",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories", "{{categoryId}}"]
            },
            "description": "Admin only. Deletes the category if it has no associated products.\n\nIf products are linked, returns `409 Conflict` with:\n\n```json\n{\n  \"status\": \"fail\",\n  \"message\": \"Cannot delete a category that has associated products\"\n}\n```"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "description": "GET requests are public for guest browsing. Create, update, and delete require an admin JWT. Run `Create Category` before creating a product.",
      "item": [
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.data?.product?.id) {",
                  "  pm.collectionVariables.set('productId', json.data.product.id);",
                  "}",
                  "",
                  "pm.test('Rating starts at zero', function () {",
                  "  pm.expect(json.data.product.ratingAverage).to.eql(0);",
                  "  pm.expect(json.data.product.ratingsCount).to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Smartphone {{$timestamp}}\",\n  \"description\": \"A product created from Postman\",\n  \"priceInMinorUnits\": 125075,\n  \"stock\": 10,\n  \"categoryId\": \"{{categoryId}}\",\n  \"image\": \"https://example.com/products/phone.jpg\",\n  \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
