        {
          "name": "Delete Address",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/addresses/{{addressId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "addresses", "{{addressId}}"]
