    {
      "name": "Cart",
      "description": "Logged-in user only. A regular user token is enough. Create a product first so `productId` is set. Adding to the cart does not decrease stock.",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cart",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cart"]
            },
            "description": "Returns the current user's cart with live product prices and `subtotal`.\n\nIf the user has never added an item, the response is `{ id: null, items: [], subtotal: 0 }` and no cart row is created.\n\n- Missing or invalid token: `401`."
          },
          "response": []
        },
        {
          "name": "Add Cart Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200 or 201', function () {",
                  "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const item = json.data?.cart?.items?.[0];",
                  "if (item?.id) {",
                  "  pm.collectionVariables.set('cartItemId', item.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cart/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cart", "items"]
            },
            "description": "Adds a product to the cart. The cart row is created on the first add.\n\nIf the product is already in the cart, the quantity is increased instead of inserting a second row.\n\n- First add: `201`.\n- Same product again: `200`.\n- Missing product or inactive product: `404`.\n- Quantity greater than stock: `400`.\n- Missing token: `401`."
          },
          "response": []
        },
        {
          "name": "Update Cart Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "const item = json.data?.cart?.items?.[0];",
                  "if (item?.id) {",
                  "  pm.collectionVariables.set('cartItemId', item.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cart/items/{{cartItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cart", "items", "{{cartItemId}}"]
            },
            "description": "Sets the quantity of a cart item. This replaces the quantity; it does not add to it.\n\n- Item not in this user's cart: `404`.\n- Quantity greater than stock: `400`.\n- Invalid item id: `400`."
          },
          "response": []
        },
        {
          "name": "Delete Cart Item",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cart/items/{{cartItemId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cart", "items", "{{cartItemId}}"]
            },
            "description": "Removes one item from the current user's cart.\n\n- Item not in this user's cart: `404`."
          },
          "response": []
        },
        {
          "name": "Clear Cart",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cart",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cart"]
            },
            "description": "Removes every item from the current user's cart. The cart row itself is kept."
          },
          "response": []
        }
